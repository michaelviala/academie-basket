# Copier ce fichier en ".env" à côté de docker-compose.yml sur le VPS, puis remplir les valeurs.

# Clés Supabase (Projet "academie-basket") — visibles dans le dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xmlhlpwtdpryefskqfde.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_C5pfRkko3MrpcV-W4wa18Q_8ilWAiZ8

# Clé secrète (Project Settings > API > "service_role" / secret keys) — ne JAMAIS préfixer par NEXT_PUBLIC_,
# ne jamais la mettre dans le code ni dans git. Nécessaire pour créer directement un compte coach
# (bouton "+ Nouveau coach") sans passer par l'auto-inscription. Sans elle, ce bouton affiche une erreur claire.
SUPABASE_SERVICE_ROLE_KEY=

# Nom de domaine public de cette app (sous-domaine sur club30.cloud)
VIRTUAL_HOST=academie.club30.cloud

# Ton email, pour les notifications de renouvellement de certificat Let's Encrypt
LETSENCRYPT_EMAIL=michael.viala@gmail.com
